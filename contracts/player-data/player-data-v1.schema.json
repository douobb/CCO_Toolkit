{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cco-toolkit:player-data:v1",
  "title": "CCO Player Data Exchange v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "exportedAt", "producer", "sections"],
  "properties": {
    "format": { "const": "cco-player-data" },
    "formatVersion": { "const": 1 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "producer": { "$ref": "#/$defs/producer" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "stableIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "portableRecordId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "safeNonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "safePositiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app", "appVersion"],
      "properties": {
        "app": {
          "allOf": [
            { "$ref": "#/$defs/stableIdentifier" },
            { "maxLength": 64 }
          ]
        },
        "appVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schemaVersion", "data"],
      "properties": {
        "id": { "$ref": "#/$defs/stableIdentifier" },
        "schemaVersion": { "$ref": "#/$defs/safePositiveInteger" },
        "data": true
      },
      "allOf": [
        {
          "if": {
            "required": ["id", "schemaVersion"],
            "properties": {
              "id": { "const": "progression" },
              "schemaVersion": { "const": 1 }
            }
          },
          "then": { "$ref": "#/$defs/progressionSectionV1" }
        },
        {
          "if": {
            "required": ["id", "schemaVersion"],
            "properties": {
              "id": { "const": "player-attributes" },
              "schemaVersion": { "const": 1 }
            }
          },
          "then": { "$ref": "#/$defs/playerAttributesSectionV1" }
        },
        {
          "if": {
            "required": ["id", "schemaVersion"],
            "properties": {
              "id": { "const": "inventory" },
              "schemaVersion": { "const": 1 }
            }
          },
          "then": { "$ref": "#/$defs/inventorySectionV1" }
        },
        {
          "if": {
            "required": ["id", "schemaVersion"],
            "properties": {
              "id": { "const": "loot-box-history" },
              "schemaVersion": { "const": 1 }
            }
          },
          "then": { "$ref": "#/$defs/lootBoxHistorySectionV1" }
        }
      ]
    },
    "progressionLevelValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value"],
      "properties": {
        "id": {
          "enum": [
            "level",
            "printing-rank",
            "medical-science",
            "ammo-crafting",
            "scavenge-skill",
            "mining-skill"
          ]
        },
        "value": { "type": "integer", "minimum": 1, "maximum": 800 }
      }
    },
    "progressionSectionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schemaVersion", "data"],
      "properties": {
        "id": { "const": "progression" },
        "schemaVersion": { "const": 1 },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["levels"],
          "properties": {
            "levels": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": { "$ref": "#/$defs/progressionLevelValue" }
            }
          }
        }
      }
    },
    "playerAttributeValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value"],
      "properties": {
        "id": {
          "enum": [
            "max-health",
            "armor",
            "destructive-weapon-damage",
            "critical-damage-percent",
            "bargain-percent",
            "damage-reduction-percent"
          ]
        },
        "value": { "$ref": "#/$defs/safeNonNegativeInteger" }
      },
      "allOf": [
        {
          "if": { "properties": { "id": { "const": "destructive-weapon-damage" } } },
          "then": { "properties": { "value": { "$ref": "#/$defs/safePositiveInteger" } } }
        },
        {
          "if": { "properties": { "id": { "const": "critical-damage-percent" } } },
          "then": { "properties": { "value": { "type": "integer", "minimum": 20, "maximum": 220 } } }
        },
        {
          "if": { "properties": { "id": { "const": "bargain-percent" } } },
          "then": { "properties": { "value": { "type": "integer", "minimum": 0, "maximum": 40 } } }
        },
        {
          "if": { "properties": { "id": { "const": "damage-reduction-percent" } } },
          "then": { "properties": { "value": { "type": "integer", "minimum": 0, "maximum": 100 } } }
        }
      ]
    },
    "playerAttributesSectionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schemaVersion", "data"],
      "properties": {
        "id": { "const": "player-attributes" },
        "schemaVersion": { "const": 1 },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["values"],
          "properties": {
            "values": {
              "type": "array",
              "maxItems": 128,
              "items": { "$ref": "#/$defs/playerAttributeValue" }
            }
          }
        }
      }
    },
    "inventoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "quantity"],
      "properties": {
        "itemId": {
          "enum": [
            "old-pouch",
            "fanny-pack",
            "explorer-backpack",
            "employee-office-case",
            "autonomous-storage-unit",
            "quantum-storage-unit",
            "tech-scrap",
            "tech-scrap-cluster",
            "medical-tech-parts",
            "medical-tech-cluster",
            "military-ammunition-tech-parts",
            "military-ammunition-tech-parts-cluster",
            "ammunition-tech-parts",
            "ammunition-tech-parts-cluster"
          ]
        },
        "quantity": { "$ref": "#/$defs/safeNonNegativeInteger" }
      }
    },
    "inventorySectionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schemaVersion", "data"],
      "properties": {
        "id": { "const": "inventory" },
        "schemaVersion": { "const": 1 },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["completeness", "items"],
          "properties": {
            "completeness": { "enum": ["complete", "partial", "manual"] },
            "items": {
              "type": "array",
              "maxItems": 10000,
              "items": { "$ref": "#/$defs/inventoryItem" }
            }
          }
        }
      }
    },
    "lootBoxDrop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dropId", "quantity"],
      "properties": {
        "dropId": {
          "enum": [
            "item-hash",
            "item-tech-scrap",
            "item-supply-crate-gang",
            "item-protocol-breach-shard",
            "item-ai-core",
            "item-old-pouch",
            "item-cybertunnel-vpn",
            "item-reward-booster-shard",
            "item-dungeon-token",
            "equipment-yellow",
            "equipment-purple",
            "equipment-red"
          ]
        },
        "quantity": { "$ref": "#/$defs/safePositiveInteger" }
      }
    },
    "lootBoxRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "recordedAt", "boxType", "openings", "drops"],
      "properties": {
        "id": { "$ref": "#/$defs/portableRecordId" },
        "recordedAt": { "type": "string", "format": "date-time" },
        "boxType": { "enum": ["white", "yellow", "purple"] },
        "openings": { "$ref": "#/$defs/safePositiveInteger" },
        "drops": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/lootBoxDrop" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "boxType": { "const": "white" } } },
          "then": { "properties": { "openings": { "maximum": 12 } } }
        },
        {
          "if": { "properties": { "boxType": { "const": "yellow" } } },
          "then": { "properties": { "openings": { "maximum": 8 } } }
        },
        {
          "if": { "properties": { "boxType": { "const": "purple" } } },
          "then": { "properties": { "openings": { "maximum": 4 } } }
        }
      ]
    },
    "lootBoxRollup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "boxType", "recordCount", "openings", "drops"],
      "properties": {
        "id": { "$ref": "#/$defs/portableRecordId" },
        "boxType": { "enum": ["white", "yellow", "purple"] },
        "recordCount": { "$ref": "#/$defs/safePositiveInteger" },
        "openings": { "$ref": "#/$defs/safePositiveInteger" },
        "drops": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/lootBoxDrop" }
        }
      }
    },
    "lootBoxHistorySectionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schemaVersion", "data"],
      "properties": {
        "id": { "const": "loot-box-history" },
        "schemaVersion": { "const": 1 },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["records", "rollups"],
          "properties": {
            "records": {
              "type": "array",
              "maxItems": 2000,
              "items": { "$ref": "#/$defs/lootBoxRecord" }
            },
            "rollups": {
              "type": "array",
              "maxItems": 256,
              "items": { "$ref": "#/$defs/lootBoxRollup" }
            }
          }
        }
      }
    }
  }
}
